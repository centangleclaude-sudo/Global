# Static export (Next.js `output: "export"`, trailingSlash: true) for Apache / cPanel

# Never show a directory listing
Options -Indexes

# Folder requests resolve to their index.html (e.g. /contact/ -> /contact/index.html)
DirectoryIndex index.html

# Serve the exported 404 page with a proper 404 status
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If an actual file or directory is requested, serve it as-is.
  #    (DirectoryIndex turns a matched directory into its index.html.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Extensionless route -> exported folder/index.html (e.g. /contact -> /contact/index.html).
  #    Internal rewrite (no external redirect), so no trailing-slash redirect loop.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # 3. Extensionless route -> flat <path>.html fallback (e.g. /404 -> /404.html).
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # 4. Nothing matched: fall through to Apache's 404 handler (ErrorDocument -> /404.html).
</IfModule>
